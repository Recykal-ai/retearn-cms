// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum DocStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum DocSourceType {
  FILE // stored via the storage adapter (local disk today, S3 later)
  LINK // points at an externally-hosted doc (e.g. Google Drive) — we store the URL only
}

model User {
  id                        String               @id @default(uuid())
  email                     String               @unique // verified @recykal.com address from Google
  name                      String
  role                      Role                 @default(USER)
  active                    Boolean              @default(true) // Super Admin can deactivate an account instead of deleting it
  // Self-service toggle (see PATCH /api/users/me) — turns off the automatic
  // emails for mentions/uploads/approval decisions. In-app Notification rows
  // (the bell) are never gated by this; only the email side effect is.
  emailNotificationsEnabled Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  documents                 Document[]           @relation("UploadedBy")
  auditLogs                 AuditLog[]
  adminScopes               AdminScope[]
  pinnedDocs                PinnedDocument[]
  personalNotes             PersonalNote[]
  personalNoteFolders       PersonalNoteFolder[]
  createdTeamNotes          TeamNote[]           @relation("TeamNoteCreator")
  createdTeamNoteFolders    TeamNoteFolder[]     @relation("TeamNoteFolderCreator")
  teamNoteMemberships       TeamNoteMembership[]
  notifications             Notification[]
  triggeredNotifications    Notification[]       @relation("NotificationTrigger")
  teamNoteActivity          TeamNoteActivity[]
  authoredTeamNoteComments  TeamNoteComment[]    @relation("TeamNoteCommentAuthor")
  resolvedTeamNoteComments  TeamNoteComment[]    @relation("TeamNoteCommentResolver")
  googleOAuthToken          GoogleOAuthToken?
}

// This user's Google OAuth grant for the drive.readonly scope (see auth.ts's
// access_type=offline) — lets the backend export a Google Sheet the user
// already has Drive access to as .xlsx, authenticated as them, so it can be
// rendered in our own view-only spreadsheet viewer instead of opening
// Sheets' own UI (where a viewer with any access can still download).
// A row only exists once the user has actually granted this scope; absence
// just means "fall back to opening the link normally" — see
// lib/google-drive.ts. Never exposed to the frontend.
model GoogleOAuthToken {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Team {
  id              String           @id @default(uuid())
  name            String           @unique
  documents       Document[]       @relation("OwningTeam")
  adminScopes     AdminScope[]
  personalNotes   PersonalNote[]
  teamNotes       TeamNote[]
  teamNoteFolders TeamNoteFolder[]
}

model Product {
  id          String            @id @default(uuid())
  name        String            @unique
  documents   DocumentProduct[]
  adminScopes AdminScope[]
}

// Scopes an ADMIN's management powers (approve/reject, category creation) to
// specific teams/products instead of every team/product. A role=ADMIN user
// with zero rows here is a "global" admin (unrestricted) — this preserves the
// original flat-role behavior as the default; scoping is opt-in per user.
// SUPER_ADMIN never has rows here — that role stays global-only by definition.
model AdminScope {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, teamId, productId])
}

model Category {
  id        String             @id @default(uuid())
  name      String
  scope     String // team id or product id this category is scoped to
  // True for every row created by the "create under every team/product at
  // once" admin action (POST /api/categories with scope "all") — the schema
  // still stores one row per scope (@@unique([name, scope]) is unchanged),
  // this just marks that the whole same-named set was created together as
  // one conceptual global tag, so the frontend can dedupe/color/list them
  // without guessing from the name alone.
  isGlobal  Boolean            @default(false)
  documents DocumentCategory[]

  @@unique([name, scope])
}

model Document {
  id                        String             @id @default(uuid())
  title                     String
  status                    DocStatus          @default(PENDING)
  rejectionNote             String?
  // Timestamp of the most recent PENDING -> PUBLISHED transition (approval or
  // auto-publish) — separate from `updatedAt`, which also moves on unrelated
  // edits like retagging. Drives the "just approved" green status dot; null
  // once that hasn't happened yet, or for docs published before this field existed.
  publishedAt               DateTime?
  // Timestamp of the most recent PENDING -> REJECTED transition. Drives how
  // long a rejected doc keeps surfacing in the main browse grid (see
  // REJECTED_VISIBLE_WINDOW_MS in document-serializer.ts) before it drops
  // out of the default view — it's never soft-deleted, so it stays fully
  // findable via the Rejected status filter or My Uploads either way.
  // Cleared (set back to null) whenever the doc leaves REJECTED status,
  // i.e. a new version is pushed.
  rejectedAt                DateTime?
  // Set when any signed-in user requests deletion of a doc they don't have
  // delete rights to outright (admins delete directly, no request needed —
  // see DELETE /:id). Surfaced in the admin Approvals queue alongside
  // pending uploads; cleared on either approve (soft-delete goes through) or
  // reject (doc stays exactly as it was, request just gets dismissed).
  deletionRequestedAt       DateTime?
  deletionRequestedById     String?
  deletionRequestNote       String?
  // Persists past deletionRequestedById being nulled on resolution — set at
  // request time, left untouched by approve/reject-deletion, so the original
  // requester can still be found in GET /mine and /mine/unseen after the
  // live field above resets.
  lastDeletionRequestedById String?
  // Set only when an Admin declines a deletion request (doc stays exactly as
  // it was); cleared back to null on the next fresh deletion request.
  // Approved deletions don't need a parallel flag — deletedAt already IS
  // that signal.
  deletionDeclinedAt        DateTime?
  ownerTeamId               String? // optional — a document needs at least one tag (team or product), not necessarily a team
  ownerTeam                 Team?              @relation("OwningTeam", fields: [ownerTeamId], references: [id])
  uploadedById              String
  uploadedBy                User               @relation("UploadedBy", fields: [uploadedById], references: [id])
  currentVersion            Int                @default(1)
  sourceType                DocSourceType      @default(FILE)
  s3Key                     String? // current version's storage key — set when sourceType = FILE
  externalUrl               String? // current version's external link — set when sourceType = LINK
  // Storage key of a server-side-converted PDF standing in for a docx/pptx
  // upload — set only when sourceType = FILE and the original was Word/
  // PowerPoint. Google's own viewer (previously used for these) shows an
  // "Open with Google Docs/Slides" button to any signed-in visitor, which
  // lets them download or edit the file — a real break of view-only
  // enforcement. Converting to PDF once (LibreOffice headless, see
  // lib/office-preview.ts) and rendering it through our own pdf.js viewer
  // closes that off entirely; the raw docx/pptx (s3Key) is kept in storage
  // for version history but its signed URL is never issued to a browser.
  previewS3Key              String?
  deletedAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  products                  DocumentProduct[]
  categories                DocumentCategory[]
  versions                  DocumentVersion[]
  pinnedBy                  PinnedDocument[]
  notifications             Notification[]

  @@index([uploadedById])
}

// A personal bookmark — per-user, doesn't affect what anyone else sees.
// Pinning a doc you don't otherwise have access to isn't specially guarded;
// it's just a private note, not a source of data exposure.
model PinnedDocument {
  userId     String
  documentId String
  user       User     @relation(fields: [userId], references: [id])
  document   Document @relation(fields: [documentId], references: [id])
  pinnedAt   DateTime @default(now())

  @@id([userId, documentId])
}

model DocumentProduct {
  documentId String
  productId  String
  document   Document @relation(fields: [documentId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@id([documentId, productId])
}

model DocumentCategory {
  documentId String
  categoryId String
  document   Document @relation(fields: [documentId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([documentId, categoryId])
}

model DocumentVersion {
  id           String        @id @default(uuid())
  documentId   String
  document     Document      @relation(fields: [documentId], references: [id])
  version      Int
  sourceType   DocSourceType @default(FILE)
  s3Key        String?
  externalUrl  String?
  // This version's own converted-PDF stand-in, same reasoning as
  // Document.previewS3Key — kept per-version so Version History can open an
  // old docx/pptx version through the in-app viewer too, not just the current one.
  previewS3Key String?
  note         String?
  uploadedBy   String
  createdAt    DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // e.g. "upload", "approve", "reject", "view", "delete"
  targetId  String // document id (or other entity) affected
  metadata  Json?
  createdAt DateTime @default(now())
}

// A private, per-user note (title/date/optional-team-label/rich-text content).
// Visible only to its own userId — no admin bypass at all, not even Super
// Admin. teamId is purely a filing label for the user's own organization; it
// grants no one else access to the note.
model PersonalNote {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  title     String
  icon      String? // an emoji, shown in place of the generic note icon (tree row + editor header)
  teamId    String?
  team      Team?               @relation(fields: [teamId], references: [id])
  folderId  String?
  folder    PersonalNoteFolder? @relation(fields: [folderId], references: [id])
  meetingAt DateTime?
  content   String              @default("") // sanitized rich-text HTML
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// Obsidian-style nested folder, purely an organizational container for one
// user's own PersonalNote rows — same owner-only visibility as the notes
// themselves, no sharing concept. parentId self-relation allows arbitrary
// nesting; a null parentId is a root-level folder. Deleting a folder is
// blocked (see personal-note-folders.ts) while it still has child folders or
// notes directly in it — no silent cascade-delete of note content.
model PersonalNoteFolder {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  name      String
  icon      String? // an emoji, shown in place of the generic folder icon
  parentId  String?
  parent    PersonalNoteFolder?  @relation("PersonalNoteFolderChildren", fields: [parentId], references: [id])
  children  PersonalNoteFolder[] @relation("PersonalNoteFolderChildren")
  notes     PersonalNote[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

// A titled, shared rich-text note scoped to one Team — a team can have many
// of these (unlike a single shared page). Creating one is a curator action
// (see canCurateTeamNoteMembers) gated to that team's Admin (global or
// scoped to it); the creator picks the initial members in the same step, so
// there's no "created but nobody can see it yet" bootstrap gap. Edited
// one-at-a-time, last-write-wins — no version history, by deliberate choice.
model TeamNote {
  id            String               @id @default(uuid())
  teamId        String
  team          Team                 @relation(fields: [teamId], references: [id])
  title         String
  icon          String? // an emoji, shown in place of the generic note icon
  folderId      String?
  folder        TeamNoteFolder?      @relation(fields: [folderId], references: [id])
  meetingAt     DateTime?
  content       String               @default("")
  createdById   String
  createdBy     User                 @relation("TeamNoteCreator", fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       TeamNoteMembership[]
  notifications Notification[]
  activity      TeamNoteActivity[]
  comments      TeamNoteComment[]
}

// Obsidian-style nested folder scoped to one Team, organizing that team's
// TeamNote rows. Purely structural — a folder's own existence is visible to
// anyone browsing that team's notes, same as a note's title; the notes
// inside are still individually membership-gated (see isTeamNoteMember), so
// a folder can list notes a given viewer can't open. Creating/renaming/
// deleting a folder is a curator action (canCurateTeamNotes), same gate as
// creating a note — regular members can't create folders, only admins
// (global or scoped to this team) and Super Admin can.
model TeamNoteFolder {
  id          String           @id @default(uuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id])
  name        String
  icon        String? // an emoji, shown in place of the generic folder icon
  parentId    String?
  parent      TeamNoteFolder?  @relation("TeamNoteFolderChildren", fields: [parentId], references: [id])
  children    TeamNoteFolder[] @relation("TeamNoteFolderChildren")
  notes       TeamNote[]
  createdById String
  createdBy   User             @relation("TeamNoteFolderCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Who can view/edit a given team note — a row here is the *only* thing that
// grants content access, with no role-based bypass for anyone (including
// Super Admin — confirmed deliberately: an unrelated team's admin has no
// reason to see this note just by virtue of their role). Curating this list
// (add/remove) is a separate permission gated by canManageTeamOrProducts
// against the note's teamId, not by membership itself.
model TeamNoteMembership {
  userId     String
  teamNoteId String
  user       User     @relation(fields: [userId], references: [id])
  teamNote   TeamNote @relation(fields: [teamNoteId], references: [id])
  addedById  String // bare id, no relation — audit-trail-only, same convention as DocumentVersion.uploadedBy
  addedAt    DateTime @default(now())

  @@id([userId, teamNoteId])
}

enum NotificationType {
  MENTION
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DELETION_APPROVED
  DELETION_REJECTED
}

// An in-app notification — either an @mention in a team note (teamNoteId,
// optionally commentId) or a document approval-flow outcome (documentId).
// Exactly one of teamNoteId/documentId is set, matching `type`.
model Notification {
  id            String           @id @default(uuid())
  userId        String // recipient
  user          User             @relation(fields: [userId], references: [id])
  type          NotificationType @default(MENTION)
  teamNoteId    String? // which team note the mention happened in
  teamNote      TeamNote?        @relation(fields: [teamNoteId], references: [id])
  // Bare id, no relation (same convention as deletionRequestedById elsewhere)
  // — lets a mention notification deep-link to the exact comment, matching
  // what the email version already does via notifyMentioned's commentId arg.
  commentId     String?
  documentId    String?
  document      Document?        @relation(fields: [documentId], references: [id])
  triggeredById String
  triggeredBy   User             @relation("NotificationTrigger", fields: [triggeredById], references: [id])
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([userId, read])
}

// One entry per distinguishable change to a team note, written by
// team-notes.ts's PUT /:id (details/content diffing) and the comment routes
// below. Deliberately structured events, not a generic text diff — see
// note-content-diff.ts. `anchorId` is only ever set for actions that point
// at something jump-to-able in the rendered content (an image's storage
// key, a linked document's id, or a comment thread's root comment id); it's
// null for EDITED_DETAILS/EDITED_CONTENT, which have nothing to scroll to.
enum TeamNoteActivityAction {
  EDITED_DETAILS
  ADDED_IMAGE
  LINKED_DOCUMENT
  ADDED_COMMENT
  RESOLVED_COMMENT
  REOPENED_COMMENT
  EDITED_CONTENT
}

model TeamNoteActivity {
  id         String                 @id @default(uuid())
  teamNoteId String
  teamNote   TeamNote               @relation(fields: [teamNoteId], references: [id])
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  action     TeamNoteActivityAction
  anchorId   String?
  metadata   Json?
  createdAt  DateTime               @default(now())

  @@index([teamNoteId, createdAt])
}

// A Notion-style comment thread anchored to a span of text (see
// CommentMarkExtension.tsx, which wraps the anchored text in the editor
// content with a data-comment-id matching the thread's root comment id —
// that mark is written once at creation time and never touched again;
// resolve/reopen only ever update this row, never the note's content, so
// resolving a thread can never appear as a content edit in the activity log).
// parentId null = the thread root (its own id doubles as the thread id);
// non-null = a reply. Only a root comment can be resolved/reopened.
model TeamNoteComment {
  id           String            @id @default(uuid())
  teamNoteId   String
  teamNote     TeamNote          @relation(fields: [teamNoteId], references: [id])
  parentId     String?
  parent       TeamNoteComment?  @relation("TeamNoteCommentReplies", fields: [parentId], references: [id])
  replies      TeamNoteComment[] @relation("TeamNoteCommentReplies")
  quotedText   String
  body         String
  authorId     String
  author       User              @relation("TeamNoteCommentAuthor", fields: [authorId], references: [id])
  resolved     Boolean           @default(false)
  resolvedById String?
  resolvedBy   User?             @relation("TeamNoteCommentResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([teamNoteId])
}
